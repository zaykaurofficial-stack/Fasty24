# Backend API (Express)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Razorpay Standard Checkout — KEY_ID only (never put KEY_SECRET here)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Google Maps JavaScript API — enable Maps JavaScript API on this key.
# Restrict by HTTP referrer. Directions/traffic ETA is fetched by the backend.
# If empty, the live tracking map uses OpenStreetMap (no key required).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
