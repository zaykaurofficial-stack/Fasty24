# Backend API (Express)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# Razorpay Standard Checkout — KEY_ID only (never put KEY_SECRET here)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Google Maps JavaScript API — enable Maps JavaScript API on this key.
# Restrict by HTTP referrer (your website domains). Do not use an IP-restricted server key here.
# Directions / traffic ETA uses GOOGLE_MAPS_SERVER_KEY on the backend.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
